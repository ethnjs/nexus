#!/usr/bin/env bash
# Formats staged backend Python files and sorts their imports.
# Files with unstaged changes are only checked, so the hook never stages work you left out.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR -- 'backend/*.py')
[[ ${#staged[@]} -eq 0 ]] && exit 0

if ! command -v uv >/dev/null; then
    echo "pre-commit: uv not found; install it or commit with --no-verify." >&2
    exit 1
fi

mapfile -t unstaged < <(git diff --name-only -- 'backend/*.py')
fix=() check=()
for f in "${staged[@]}"; do
    if printf '%s\n' "${unstaged[@]}" | grep -qxF "$f"; then
        check+=("${f#backend/}")
    else
        fix+=("${f#backend/}")
    fi
done

cd "$root/backend"
if [[ ${#fix[@]} -gt 0 ]]; then
    uv run --quiet ruff check --select I --fix --quiet "${fix[@]}"
    uv run --quiet ruff format --quiet "${fix[@]}"
    git add -- "${fix[@]}"
fi
bad=()
for f in "${check[@]}"; do
    # Check the staged version, which is what gets committed.
    if ! git show ":backend/$f" | uv run --quiet ruff format --check --quiet --stdin-filename "$f" - \
        || ! git show ":backend/$f" | uv run --quiet ruff check --select I --quiet --stdin-filename "$f" - >/dev/null; then
        bad+=("$f")
    fi
done
if [[ ${#bad[@]} -gt 0 ]]; then
    echo "pre-commit: these files have unstaged changes, so they weren't fixed:" >&2
    printf '  backend/%s\n' "${bad[@]}" >&2
    echo "Run 'uv run ruff format' and 'uv run ruff check --select I --fix' in backend/, then stage." >&2
    exit 1
fi
