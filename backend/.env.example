APP_ENV=development
DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:5432/nexus

# Local dev: path to a service account credentials file (see Docker setup in CONTRIBUTING.md)
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json
# Prod only: JSON string instead of a file, set as a platform env var — never commit a real value here
GOOGLE_SERVICE_ACCOUNT_JSON=

# Blank in dev = skipped. Required in prod.
API_KEY=

# Required for email verification/reset emails to actually send — leave blank to no-op in dev
RESEND_API_KEY=

FRONTEND_URL=http://localhost:3000/

# Google sign-in. Web OAuth client, not the service account above. Blank = the
# button reports unavailable. Redirect URI must match the registered one exactly
# (dev, direct to the backend: http://localhost:8001/auth/oauth/google/callback/).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Prod must override the dev default; startup refuses it there.
OAUTH_STATE_SECRET=

# Discord. Blank DISCORD_BOT_TOKEN = Discord is off: its routes 404 and lobot
# never connects. CONTRIBUTING.md's "Discord dev setup" covers the dev app.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=
DISCORD_LINK_REDIRECT_URI=http://localhost:3000/api/proxy/auth/oauth/discord/callback
DISCORD_INSTALL_REDIRECT_URI=http://localhost:3000/api/proxy/discord/install/callback
# DEV ONLY. Your test server's id: slash commands register there and update instantly.
# Never set in production or preview, where commands must be global.
DISCORD_DEV_GUILD_ID=
