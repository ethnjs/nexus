APP_ENV=development
DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:5432/nexus

# Local dev: path to a service account credentials file (see Docker setup in CONTRIBUTING.md)
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json
# Prod only: JSON string instead of a file, set as a platform env var — never commit a real value here
GOOGLE_SERVICE_ACCOUNT_JSON=

# Blank in dev = skipped. Required in prod.
API_KEY=

# Dev-only default below — must be a long random string in prod, set as a platform env var
JWT_SECRET=dev-secret-change-in-production

# Amazon SES — required for emails to actually send. Leave both keys blank in dev to skip
# sending (the email is logged instead). Required in prod, set as platform env vars — never commit real values here
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Must match the region where the SES sending identity is verified
AWS_REGION=us-west-2
# Must be an SES-verified address or domain in the account/region above
EMAIL_FROM_ADDRESS=NEXUS <verify@nexus.socalscioly.org>
# Emails per second. Sandbox accounts are capped at 1 — raise to the account's production quota.
# Pacing is per process: with N uvicorn workers/replicas, set this to quota / N
SES_MAX_SEND_RATE=1
# Total attempts per send (including the first) before a throttle/transient error counts as a failure
SES_MAX_ATTEMPTS=4

FRONTEND_URL=http://localhost:3000/
