APP_ENV=development
DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:5432/nexus

# Local dev: path to a service account credentials file (see Docker setup in CONTRIBUTING.md)
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json
# Prod only: JSON string instead of a file, set as a platform env var — never commit a real value here
GOOGLE_SERVICE_ACCOUNT_JSON=

# Blank in dev = skipped. Required in prod.
API_KEY=

# Amazon SES. Blank keys in dev = email is logged instead of sent. Required in prod, set as platform env vars — never commit real values here
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The region and sender must match an SES-verified identity
AWS_REGION=us-west-2
EMAIL_FROM_ADDRESS=NEXUS <verify@nexus.socalscioly.org>
# Emails per second: the account's SES quota (1 in the sandbox) divided by the number of uvicorn workers/replicas
SES_MAX_SEND_RATE=1
# Attempts per send, including the first, before a throttled send counts as failed
SES_MAX_ATTEMPTS=4

# Set to the real URL in prod
FRONTEND_URL=http://localhost:3000/
